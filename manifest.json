{
  "manifest_version": 3,
  "name": "YTM Glass PiP",
  "version": "0.2",
  "description": "유튜브 뮤직 미니 플레이어 (Document Picture-in-Picture)",
  "action": { "default_title": "YouTube Music PiP" },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [{ "matches": ["https://music.youtube.com/*"], "js": ["pip.bundle.js"], "run_at": "document_idle" }],
  "commands": { "_execute_action": {} }
}
